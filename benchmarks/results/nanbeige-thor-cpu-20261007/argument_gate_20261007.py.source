for algorithm in ['ppo','grpo','dppo','flow-dppo']:
 def capture(path,run_name):
  args=parse_args()
  assert args.params_dtype==torch.float32 and args.offload_train
  assert args.rlt_model_family=='nanbeige' and args.rlt_depth==2
  assert (args.actor_num_gpus_per_node,args.rollout_num_gpus)==(1,1)
  assert args.num_rollout==3 and args.rollout_max_response_len==48
  assert args.n_samples_per_prompt==(4 if algorithm=='grpo' else 1)
  assert args.use_critic==(algorithm!='grpo')
  assert args.use_tis==(algorithm=='dppo')
  assert args.num_steps_per_rollout==(2 if algorithm=='flow-dppo' else 1)
  actor=parse_megatron_role_args(args,args.megatron_config_path,'actor')
  assert not actor.use_distributed_optimizer
  assert not torch.cuda.is_initialized()
  records.append({'algorithm':algorithm,'dtype':str(args.params_dtype),'offload_train':args.offload_train,'train_gpus':args.actor_num_gpus_per_node,'rollout_gpus':args.rollout_num_gpus,'updates':args.num_rollout,'group_size':args.n_samples_per_prompt,'steps_per_rollout':args.num_steps_per_rollout,'critic':args.use_critic,'cuda_initialized':False})
 sys.argv=['run.py','--model',str(model),'--data',str(data),'--output',str(root/'evidence/parser-fixtures'/algorithm),'--algorithm',algorithm,'--updates','3','--model-revision','b82e54bd609793562a75cbf9337970a93369eab5','--engine-revision','d2a358933393f25d74dd2bdd1068a741cd5d9226','--recompute']
